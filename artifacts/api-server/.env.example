# ── Infrastructure ─────────────────────────────────────────────────────────────
DATABASE_URL=
SESSION_SECRET=

# ── Admin ───────────────────────────────────────────────────────────────────────
ADMIN_SECRET_KEY=

# ── TrueLayer (Open Banking) ────────────────────────────────────────────────────
# "sandbox" uses mock bank data; switch to "production" with real credentials
TRUELAYER_ENV=sandbox
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=

# ── Billing ─────────────────────────────────────────────────────────────────────
# "stripe" or "paystack"
PAYMENT_PROVIDER=stripe
# "demo" uses Stripe test mode; "live" uses real charges
STRIPE_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=

# ── Google / Gmail ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Misc ────────────────────────────────────────────────────────────────────────
# 64-char hex AES-256 key for encrypting bank tokens
ENCRYPTION_KEY=
